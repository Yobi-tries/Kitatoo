<% content_for(:meta_title, "Create My Artist Profile — Kitatoo") %>

<%= render "shared/topappbar" %>

<div class="container profile-form">
  <div class="profile-form-card">
    <h1 class="profile-form-title">Become a tattoo artist on Kitatoo</h1>
    <p class="profile-form-hint">Create your artist profile to be visible to clients.</p>

    <%= simple_form_for @artist_profile, url: artist_profile_path, method: :post do |f| %>
      <%= f.error_notification %>

      <%= f.input :display_name,
                  label: "Artist / studio name",
                  placeholder: "e.g. Jax Blackwood",
                  required: true,
                  input_html: { autofocus: true } %>

      <div class="profile-form-actions">
        <button type="submit" class="profile-form-submit">Create my artist profile</button>
      </div>
    <% end %>
  </div>
</div>

<%= render "shared/botappbar" %>
