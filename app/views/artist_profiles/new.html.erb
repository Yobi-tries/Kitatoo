<div class="container py-4" style="max-width: 480px;">
  <h1 class="h3 mb-1">Become a tattoo artist on KiTatoo</h1>

  <%= simple_form_for @artist_profile, url: artist_profile_path, method: :post do |f| %>
    <%= f.error_notification %>

    <div class="form-inputs">
      <%= f.input :display_name,
                  label: "Artist / studio name",
                  placeholder: "e.g. Jax Blackwood",
                  required: true,
                  input_html: { autofocus: true } %>
    </div>

    <div class="form-actions">
      <%= f.button :submit, "Create my artist profile", class: "btn btn-primary w-100" %>
    </div>
  <% end %>
</div>
