<%= render "shared/topappbar" %>

<div class="container profile-form">
  <div class="profile-form-card">
    <h1 class="profile-form-title">Complete your artist profile</h1>
    <p class="profile-form-hint">Fill in your bio, styles and pricing so clients can find and evaluate you.</p>

  <%= simple_form_for @artist_profile, url: artist_profile_path, method: :patch, html: { multipart: true } do |f| %>
    <%= f.error_notification %>

    <div class="avatar-edit-wrapper mb-4" data-controller="avatar">
      <label class="avatar-edit-label" for="artist_profile_avatar">
        <%= image_tag @artist_profile.avatar_url.presence || "https://ui-avatars.com/api/?size=176&background=000000&color=ffffff&name=#{@artist_profile.display_name.tr(" ", "+")}",
              class: "avatar-edit-preview", alt: @artist_profile.display_name, data: { avatar_target: "preview" } %>
        <span class="avatar-edit-icon">
          <span class="material-symbols-outlined">photo_camera</span>
        </span>
      </label>
      <%= f.file_field :avatar, accept: "image/*", class: "d-none",
            data: { avatar_target: "input", action: "change->avatar#preview" } %>
    </div>

    <div class="form-inputs">
      <%= f.input :display_name,
                  label: "Artist / studio name",
                  required: true %>

      <%= f.input :professional_status,
                  label: "Professional status",
                  placeholder: "e.g. Independent" %>

      <%= f.input :bio,
                  as: :text,
                  label: "Bio",
                  placeholder: "Tell clients about your work and experience...",
                  input_html: { rows: 4 } %>

      <div class="form-group mb-3">
        <label class="form-label d-block">Styles</label>

        <div class="tags-field"
             data-controller="tags"
             data-tags-available-value="<%= Tag.order(:name).pluck(:name).to_json %>"
             data-action="click@document->tags#outsideClick">
          <div class="d-flex flex-wrap gap-2 mb-2" data-tags-target="pills">
            <% @artist_profile.tags.map(&:name).each do |name| %>
              <span class="badge rounded-pill text-bg-dark d-inline-flex align-items-center gap-2 py-2 px-3"
                    data-tags-target="pill" data-name="<%= name.downcase %>">
                <%= name %>
                <input type="hidden" name="artist_profile[tag_names][]" value="<%= name %>">
                <button type="button" class="btn-close btn-close-white" style="font-size: 0.55rem;"
                        data-action="tags#remove" aria-label="Remove"></button>
              </span>
            <% end %>
          </div>

          <div class="tags-autocomplete">
            <input type="text" class="form-control" placeholder="Add a style..." autocomplete="off"
                   data-tags-target="input"
                   data-action="focus->tags#onFocus input->tags#onInput
                                 keydown.down->tags#moveDown keydown.up->tags#moveUp
                                 keydown.enter->tags#commit keydown.escape->tags#closeDropdown">

            <div class="tags-dropdown d-none" data-tags-target="dropdown"></div>
          </div>
        </div>
      </div>

      <div class="form-group mb-3">
        <label class="form-label d-block">Pricing</label>

        <div data-controller="pricing">
          <div data-pricing-target="list">
            <% (@artist_profile.pricing_grid.presence || [ {} ]).each_with_index do |item, index| %>
              <div class="row mb-2 align-items-center" data-pricing-target="row">
                <div class="col-6">
                  <input type="text" name="artist_profile[pricing_grid][<%= index %>][prestation]"
                         value="<%= item['prestation'] %>" class="form-control" placeholder="Service">
                </div>
                <div class="col-4">
                  <div class="input-group">
                    <input type="number" name="artist_profile[pricing_grid][<%= index %>][prix]"
                           value="<%= item['prix'] %>" class="form-control" placeholder="Price" step="0.01" min="0">
                    <span class="input-group-text">€</span>
                  </div>
                </div>
                <div class="col-2">
                  <button type="button" class="btn btn-outline-danger btn-sm" data-action="pricing#remove">✕</button>
                </div>
              </div>
            <% end %>
          </div>

          <button type="button" class="btn btn-outline-secondary btn-sm mt-2" data-action="pricing#add">
            + Add a service
          </button>
        </div>
      </div>

      <div class="form-group mb-3">
        <label class="form-label d-block">Social links</label>
        <% links = @artist_profile.social_links || {} %>
        <div class="social-links-fields">
          <div class="social-link-row">
            <span class="social-link-icon"><i class="fa-brands fa-instagram"></i></span>
            <input type="text" name="artist_profile[social_links][instagram]"
                   value="<%= links.is_a?(Hash) ? links["instagram"] : "" %>"
                   class="form-control" placeholder="Instagram profile URL">
          </div>
          <div class="social-link-row">
            <span class="social-link-icon"><i class="fa-brands fa-pinterest"></i></span>
            <input type="text" name="artist_profile[social_links][pinterest]"
                   value="<%= links.is_a?(Hash) ? links["pinterest"] : "" %>"
                   class="form-control" placeholder="Pinterest profile URL">
          </div>
        </div>
      </div>
    </div>

    <hr class="my-4">

    <% schedule = @artist_profile.schedule || {} %>
    <% days_data = schedule["days"] || {} %>

    <div class="schedule" data-controller="schedule">
      <div class="schedule-header">
        <h4>Availability schedule</h4>
        <p class="schedule-hint">Set your recurring weekly availability. This repeats every week during the period.</p>
      </div>

      <div class="schedule-period">
        <div class="schedule-period-field">
          <label class="schedule-label">Period start</label>
          <input type="date" name="artist_profile[schedule][period_start]"
                 value="<%= schedule["period_start"] %>" class="form-control">
        </div>
        <div class="schedule-period-field">
          <label class="schedule-label">Period end</label>
          <input type="date" name="artist_profile[schedule][period_end]"
                 value="<%= schedule["period_end"] %>" class="form-control">
        </div>
      </div>

      <div class="schedule-slot-duration">
        <label class="schedule-label">Slot duration</label>
        <select name="artist_profile[schedule][slot_duration]" class="form-select">
          <% [15, 30, 45, 60, 75, 90, 105, 120].each do |min| %>
            <option value="<%= min %>" <%= "selected" if schedule["slot_duration"].to_i == min %>><%= min %> min</option>
          <% end %>
        </select>
      </div>

      <div class="schedule-weekly">
        <h5 class="schedule-section-title">Weekly hours</h5>
        <% %w[monday tuesday wednesday thursday friday saturday sunday].each do |day| %>
          <% day_data = days_data[day] %>
          <% enabled = day_data.present? %>
          <div class="schedule-day-row" data-schedule-target="dayRow">
            <div class="schedule-day-toggle">
              <input type="hidden" name="artist_profile[schedule][days][<%= day %>][enabled]" value="0">
              <input type="checkbox" class="form-check-input" name="artist_profile[schedule][days][<%= day %>][enabled]"
                     value="1" <%= "checked" if enabled %> data-action="schedule#toggleDay">
              <label class="schedule-day-label"><%= day.capitalize %></label>
            </div>
            <div class="schedule-day-times">
              <input type="time" name="artist_profile[schedule][days][<%= day %>][start]"
                     value="<%= day_data&.dig("start") %>" class="form-control form-control-sm"
                     <%= "disabled" unless enabled %> data-schedule-target="timeInput">
              <span class="schedule-day-separator">—</span>
              <input type="time" name="artist_profile[schedule][days][<%= day %>][end]"
                     value="<%= day_data&.dig("end") %>" class="form-control form-control-sm"
                     <%= "disabled" unless enabled %> data-schedule-target="timeInput">
            </div>
          </div>
        <% end %>
      </div>

      <div class="schedule-days-off">
        <h5 class="schedule-section-title">Days off</h5>
        <div class="schedule-days-off-list" data-schedule-target="daysOffList">
          <% (schedule["days_off"] || []).each_with_index do |date, index| %>
            <div class="schedule-day-off-chip" data-schedule-target="dayOffRow">
              <input type="date" name="artist_profile[schedule][days_off][<%= index %>]"
                     value="<%= date %>" class="schedule-day-off-input">
              <button type="button" class="schedule-day-off-remove" data-action="schedule#removeDayOff">✕</button>
            </div>
          <% end %>
        </div>
        <button type="button" class="schedule-add-btn" data-action="schedule#addDayOff">
          <i class="fa-solid fa-plus"></i> Add a day off
        </button>
      </div>
    </div>

    <div class="profile-form-actions">
      <%= f.button :submit, "Save profile", class: "profile-form-submit" %>
    </div>
  <% end %>
  </div>
</div>

<%= render "shared/botappbar" %>
