<%= render "shared/topappbar" %>

<div class="container artist-show px-0">

  <% if @user.avatar_url.present? %>
    <%= image_tag @user.avatar_url, class: "artist-cover", alt: @user.username %>
  <% else %>
    <div class="artist-cover-placeholder">PHOTO</div>
  <% end %>

  <div class="artist-identity">
    <h1 class="artist-identity-name"><%= @user.username %></h1>

    <% if @user.city.present? %>
      <p class="artist-identity-bio"><i class="fa-solid fa-location-dot"></i> <%= @user.city %></p>
    <% end %>
  </div>

  <div class="artist-actions" style="grid-template-columns: 1fr;">
    <%= link_to "Edit my profile", edit_user_path, class: "artist-action-edit" %>
  </div>

  <% if @user.bio.present? %>
    <div class="artist-section">
      <div class="artist-info-card artist-info-card--row">
        <span class="artist-info-card-icon"><i class="fa-solid fa-quote-left"></i></span>
        <div>
          <span class="artist-info-card-value">About me</span>
          <span class="artist-info-card-label"><%= @user.bio %></span>
        </div>
      </div>
    </div>
  <% end %>

  <div class="artist-section">
    <h2 class="artist-section-title">My Likes</h2>
    <% if @liked_artist_profiles.any? %>
      <div class="row g-2 mb-4">
        <% @liked_artist_profiles.each do |artist_profile| %>
          <div class="col-4">
            <%= link_to artist_path(artist_profile) do %>
              <% cover = artist_profile.cover_image || artist_profile.portfolio_items.first %>
              <% if cover %>
                <%= image_tag cover.image_url, class: "img-fluid rounded-2", alt: artist_profile.display_name %>
              <% else %>
                <div class="like-placeholder rounded-2">
                  <span class="like-placeholder-name"><%= artist_profile.display_name %></span>
                </div>
              <% end %>
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-muted small">No likes yet. Explore artists and tap the heart to save your favorites!</p>
    <% end %>
  </div>

</div>

<%= render "shared/botappbar" %>
