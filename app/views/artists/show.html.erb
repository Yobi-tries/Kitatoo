<% owner = user_signed_in? && current_user.artist_profile == @artist_profile %>

<%= render "shared/topappbar" %>

<div class="container artist-show px-0">

  <% cover = @artist_profile.cover_image || @artist_profile.portfolio_items.first %>
  <% if cover %>
    <%= image_tag cover.image_url, class: "artist-cover", alt: @artist_profile.display_name %>
  <% else %>
    <div class="artist-cover-placeholder">PHOTO</div>
  <% end %>

  <div class="artist-identity">
    <% if @artist_profile.professional_status.present? %>
      <span class="artist-identity-status"><%= @artist_profile.professional_status %></span>
    <% end %>

    <h1 class="artist-identity-name"><%= @artist_profile.display_name %></h1>

    <% if @artist_profile.bio.present? %>
      <p class="artist-identity-bio"><%= truncate(@artist_profile.bio, length: 150) %></p>
    <% end %>

    <div class="artist-identity-chips">
      <% @tags.each do |tag| %>
        <%= link_to tag.name, root_path(style: tag.name), class: "artist-chip" %>
      <% end %>
    </div>
  </div>

  <% if owner %>
    <div class="artist-actions" style="grid-template-columns: 1fr;">
      <%= link_to "Edit my profile", edit_artist_profile_path,
                  class: "artist-action-edit artist-action-edit--primary" %>
    </div>
  <% else %>
    <div class="artist-actions" style="grid-template-columns: <% if user_signed_in? %>auto 1fr 1.35fr<% else %>1fr 1.35fr<% end %>;">
      <% if user_signed_in? %>
        <% liked = current_user.likes.exists?(artist_profile: @artist_profile) %>
        <% if liked %>
          <%= button_to artist_profile_like_path(@artist_profile), method: :delete, class: "artist-action-like artist-action-like--active" do %>
            <i class="fa-solid fa-heart"></i>
          <% end %>
        <% else %>
          <%= button_to artist_profile_like_path(@artist_profile), method: :post, class: "artist-action-like" do %>
            <i class="fa-regular fa-heart"></i>
          <% end %>
        <% end %>
      <% end %>
      <%= link_to new_artist_profile_conversation_path(@artist_profile), class: "artist-action-message" do %>
        <i class="fa-regular fa-comment"></i> Message
      <% end %>
      <%= link_to artist_profile_public_availabilities_path(@artist_profile), class: "artist-action-book" do %>
        <i class="fa-regular fa-calendar"></i> Book now
      <% end %>
    </div>
  <% end %>

  <% if @min_price.present? %>
    <div class="artist-section">
      <div class="artist-info-card artist-info-card--row" role="button" data-bs-toggle="modal" data-bs-target="#pricingModal">
        <span class="artist-info-card-icon"><i class="fa-solid fa-money-bill"></i></span>
        <div>
          <span class="artist-info-card-value"><%= @min_price %> – <%= @max_price %> €</span>
          <% slot = @artist_profile.schedule&.dig("slot_duration") %>
          <span class="artist-info-card-label">
            <% if slot %>Minimum session: <%= slot %> min. <% end %>
            Custom rates available upon request.
          </span>
        </div>
      </div>
    </div>
  <% end %>

  <div class="artist-section">
    <% @artist_profile.addresses.each do |address| %>
      <div class="artist-info-card position-relative">
        <div class="artist-info-card--row">
          <span class="artist-info-card-icon"><i class="fa-solid fa-location-dot"></i></span>
          <div class="flex-grow-1">
            <span class="artist-info-card-value"><%= address.label.presence || "Studio" %></span>
            <span class="artist-address-detail"><%= address.street %>, <%= address.zipcode %> <%= address.city %></span>
          </div>
          <% if address.latitude.present? %>
            <a href="https://www.google.com/maps/search/?api=1&query=<%= address.latitude %>,<%= address.longitude %>" target="_blank" class="artist-map-link stretched-link">Map</a>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <div class="artist-section">
    <% if owner %>
      <%= form_with url: bulk_destroy_artist_profile_portfolio_items_path, method: :delete,
                    data: { controller: "portfolio", turbo_confirm: "Remove the selected photos?" } do %>
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h2 class="artist-section-title mb-0">Portfolio</h2>
          <div class="d-flex align-items-center gap-3">
            <button type="button" class="btn btn-link p-0" data-bs-toggle="modal"
                    data-bs-target="#portfolioUploadModal" aria-label="Add photos">
              <i class="fa-solid fa-plus"></i>
            </button>
            <% if @artist_profile.portfolio_items.any? %>
              <button type="button" class="btn btn-link p-0"
                      data-portfolio-target="trash"
                      data-action="portfolio#enable" aria-label="Delete photos">
                <i class="fa-solid fa-trash"></i>
              </button>
              <%= submit_tag "Delete", class: "btn btn-danger btn-sm d-none",
                    data: { portfolio_target: "confirm" } %>
              <button type="button" class="btn btn-link p-0"
                      data-portfolio-target="pin"
                      data-action="portfolio#pin" aria-label="Choose cover">
                <i class="fa-solid fa-thumbtack"></i>
              </button>
            <% end %>
          </div>
        </div>

        <div class="row g-2 mb-4">
          <% @artist_profile.portfolio_items.each do |item| %>
            <div class="col-4">
              <div class="position-relative">
                <label class="d-block">
                  <%= check_box_tag "ids[]", item.id, false,
                        class: "form-check-input position-absolute m-2 d-none",
                        data: { portfolio_target: "checkbox" } %>
                  <%= image_tag item.image_url, alt: item.caption,
                        class: "img-fluid rounded-2 #{"portfolio-cover" if item.position == 1}" %>
                </label>
                <%= link_to artist_profile_portfolio_item_path(item, role: "cover"),
                      data: { turbo_method: :patch, portfolio_target: "cover" },
                      class: "btn btn-sm btn-light position-absolute top-0 end-0 m-2 d-none",
                      title: "Use as cover" do %>
                  <i class="fa-solid fa-thumbtack"></i>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    <% else %>
      <h2 class="artist-section-title">Portfolio</h2>
      <% if @artist_profile.portfolio_items.any? %>
               <div data-controller="album">
          <div class="row g-2 mb-4">
            <% @artist_profile.portfolio_items.each_with_index do |item, index| %>
              <div class="col-4">
                <button type="button" class="btn p-0 border-0 w-100"
                        data-bs-toggle="modal" data-bs-target="#albumModal"
                        data-action="click->album#open"
                        data-album-index="<%= index %>">
                  <%= image_tag item.image_url, class: "img-fluid rounded-2", alt: item.caption %>
                </button>
              </div>
            <% end %>
          </div>

          <div class="modal fade" id="albumModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-fullscreen">
              <div class="modal-content bg-dark">
                <div class="modal-header border-0">
                  <button type="button" class="btn-close btn-close-white ms-auto"
                          data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body d-flex align-items-center p-0">
                  <div id="albumCarousel" class="carousel slide w-100">
                    <div class="carousel-inner">
                      <% @artist_profile.portfolio_items.each_with_index do |item, index| %>
                        <div class="carousel-item <%= "active" if index.zero? %>"
                             data-album-target="slide">
                          <%= image_tag item.image_url, class: "d-block w-100", alt: item.caption %>
                        </div>
                      <% end %>
                    </div>
                    <button class="carousel-control-prev" type="button"
                            data-bs-target="#albumCarousel" data-bs-slide="prev">
                      <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                      <span class="visually-hidden">Previous</span>
                    </button>
                    <button class="carousel-control-next" type="button"
                            data-bs-target="#albumCarousel" data-bs-slide="next">
                      <span class="carousel-control-next-icon" aria-hidden="true"></span>
                      <span class="visually-hidden">Next</span>
                    </button>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

      <% else %>
        <p class="text-muted small">No photos yet.</p>
      <% end %>
    <% end %>
  </div>

  <% if owner %>
    <div class="artist-section text-center">
      <%= button_to "Sign out", destroy_user_session_path, method: :delete, class: "btn-sign-out" %>
    </div>
  <% end %>

</div>

<div class="modal fade" id="pricingModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Prices</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <ul class="list-unstyled mb-0">
          <% @prices.each do |row| %>
            <li class="d-flex justify-content-between border-bottom py-2">
              <span><%= row["prestation"] %></span>
              <span class="fw-bold"><%= row["prix"] %> €</span>
            </li>
          <% end %>
        </ul>
      </div>
    </div>
  </div>
</div>

<%= render "shared/botappbar" %>
