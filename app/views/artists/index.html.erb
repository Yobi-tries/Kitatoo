<%= render "shared/topappbar" %>

<div class="container artists-index py-3" style="max-width: 640px;">

  <%= form_with url: root_path, method: :get do %>
    <%= text_field_tag :query, params[:query],
          placeholder: "Search artists, styles, studios...",
          class: "form-control rounded-pill px-3" %>
  <% end %>

  <div class="d-flex justify-content-between align-items-center mt-4 mb-2">
    <h2 class="h5 mb-0">Discover Styles</h2>
    <button type="button" class="btn btn-link p-0" data-bs-toggle="modal" data-bs-target="#styleSearch">
      <i class="fa-solid fa-magnifying-glass"></i>
    </button>
  </div>

  <div class="d-flex gap-2 overflow-auto pb-2">
    <% @styles.first(8).each do |style| %>
      <%= link_to style, root_path(style: style),
            class: "btn btn-dark rounded-3 flex-shrink-0 px-4 py-4 text-nowrap" %>
    <% end %>
  </div>

  <div class="d-flex justify-content-between align-items-center mt-4 mb-2">
    <h2 class="h5 mb-0"><%= @searching ? "Results" : "Nearby Artists" %></h2>
    <button type="button" class="btn btn-link p-0" data-bs-toggle="modal" data-bs-target="#locationSearch">
      <i class="fa-solid fa-magnifying-glass"></i>
    </button>
  </div>

  <p class="text-muted small">
    <%= @artists.size %> artists
    <% if @searching %>
      &middot; <%= link_to "Clear", root_path %>
    <% end %>
  </p>

  <% @artists.each do |artist| %>
    <div class="card mb-3">
      <div class="card-body d-flex align-items-center gap-3">
        <%= image_tag "https://kitt.lewagon.com/placeholder/users/#{artist.user.username}",
              class: "avatar-large", alt: artist.display_name %>
        <div>
          <h3 class="h6 mb-1">
            <%= link_to artist.display_name, artist_path(artist), class: "text-decoration-none" %>
          </h3>
          <p class="text-muted small mb-0">
            <%= artist.styles %>
            <% if artist.addresses.any? %>
              &middot; <%= artist.addresses.map(&:city).uniq.join(", ") %>
            <% end %>
          </p>
        </div>
      </div>
    </div>
  <% end %>


</div>

<div class="modal fade" id="styleSearch" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Search by style</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body d-flex flex-wrap gap-2">
        <% @styles.each do |style| %>
          <%= link_to style, root_path(style: style), class: "btn btn-outline-dark btn-sm" %>
        <% end %>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="locationSearch" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Search by location</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="d-flex flex-wrap gap-2">
          <% @cities.each do |city| %>
            <%= link_to city, root_path(location: city), class: "btn btn-outline-dark btn-sm" %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<%= render "shared/botappbar" %>
