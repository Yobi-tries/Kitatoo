<%= render "shared/topappbar" %>

<% unless @searching %>
  <%= render "shared/find_your_hero" %>
<% end %>

<div class="container home<%= ' home--no-hero' if @searching %>" data-controller="sticky-search">

  <div class="home-search-placeholder" data-sticky-search-target="placeholder">
    <%= form_with url: root_path,
                  method: :get,
                  class: "home-search-form",
                  data: { sticky_search_target: "bar" } do %>
      <span class="material-symbols-outlined home-search-icon" aria-hidden="true">search</span>
      <%= text_field_tag :query, params[:query],
            placeholder: "Search artists, styles, studios...",
            aria: { label: "Search artists, styles, studios" },
            class: "home-search" %>
    <% end %>
  </div>

  <div class="home-section-header">
    <h2 class="home-section-title">Discover Styles</h2>
  </div>

  <div data-controller="scroll-indicator">
    <div class="home-styles-scroller" data-scroll-indicator-target="scroller" data-action="scroll->scroll-indicator#update">
      <% @style_counts.first(8).each_with_index do |(style, count), index| %>
        <%= link_to root_path(style: style), class: "style-tile" do %>
          <% image = "styles/#{style.parameterize}.webp" %>
          <% if Rails.root.join("app/assets/images", image).exist? %>
            <%= image_tag image, class: "style-tile-image", alt: "" %>
          <% end %>
          <span class="style-tile-count"><%= count %> artists</span>
          <span class="style-tile-name"><%= style %></span>
        <% end %>
      <% end %>
    </div>
    <div class="home-scroll-indicator">
      <span class="home-scroll-dot home-scroll-dot--active" data-scroll-indicator-target="dot"></span>
      <span class="home-scroll-dot" data-scroll-indicator-target="dot"></span>
      <span class="home-scroll-dot" data-scroll-indicator-target="dot"></span>
    </div>
  </div>

  <div data-controller="map"
       data-map-markers-value="<%= @map_markers.to_json %>"
       data-map-api-key-value="<%= ENV["MAPBOX_API_KEY"] %>">

    <div class="home-section-header">
      <div>
        <h2 class="home-section-title"><%= @searching ? "Results" : "Nearby Artists" %></h2>
        <span class="home-section-meta">
          <span data-map-target="count"><%= @artists.size %></span> · <%= @default_city || "Paris" %>
          <% if @searching %>
            &middot; <%= link_to "Clear", root_path %>
          <% end %>
        </span>
      </div>

      <div class="view-switch">
        <button type="button" class="view-switch-option view-switch-option--active"
                data-map-target="listButton" data-action="map#showList">
          <i class="fa-solid fa-list-ul"></i>
        </button>
        <button type="button" class="view-switch-option"
                data-map-target="mapButton" data-action="map#showMap">
          <i class="fa-solid fa-map-location-dot"></i>
        </button>
      </div>
    </div>

    <% if @map_markers.any? %>
      <div class="home-map" data-map-target="canvas" hidden></div>
    <% end %>

    <div class="home-artists-list" data-map-target="list">
      <% @artists.each do |artist| %>
        <% locations = artist.addresses.filter_map { |address| [address.longitude, address.latitude] if address.longitude.present? && address.latitude.present? } %>
        <div class="artist-card" data-map-target="card"
             data-locations="<%= locations.to_json %>">
          <%= image_tag artist.avatar_url.presence || "https://ui-avatars.com/api/?size=124&background=16130F&color=FBF9F5&name=#{artist.display_name.tr(" ", "+")}",
                class: "artist-card-thumb", alt: artist.display_name %>
          <div class="artist-card-body">
            <h3 class="artist-card-name">
              <%= link_to artist.display_name, artist_path(artist), class: "stretched-link" %>
            </h3>
            <span class="artist-card-meta">
              <%= artist.styles %>
              <% if artist.addresses.any? %>
                &middot; <%= artist.addresses.map { |a| a.city }.uniq.join(", ") %>
              <% end %>
            </span>
            <% if @distances[artist.id] %>
              <span class="artist-card-status">
                <span class="artist-card-dot"></span>
                Booking open &middot; <%= @distances[artist.id].round(1) %> km
              </span>
            <% end %>
          </div>
          <i class="fa-solid fa-chevron-right artist-card-chevron"></i>
        </div>
      <% end %>
    </div>
    <button type="button" class="home-see-more"
            data-map-target="more" data-action="map#showMore" hidden>
      See more artists
    </button>
  </div>
  <%= link_to "Tattoo idea generator",
              new_tattoo_generation_path,
              class: "home-see-more home-generator-button" %>
</div>

<%= render "shared/botappbar", hidden: @searching ? false : true %>
