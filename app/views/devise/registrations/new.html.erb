<% content_for(:meta_title, "Create My Account — Kitatoo") %>

<div class="auth">
  <div class="auth-card">
    <div class="auth-logo">
      <%= link_to root_path, class: "topappbar-title" do %>Kitat<span class="topappbar-title__accent">oo</span><% end %>
    </div>
    <h2 class="auth-title">Create your account</h2>
    <p class="auth-hint">Join Kitatoo to find and book tattoo artists</p>

    <%= simple_form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
      <%= f.error_notification %>

      <%= f.input :username,
                  required: true,
                  input_html: { autocomplete: "username" } %>
      <%= f.input :email,
                  required: true,
                  autofocus: true,
                  input_html: { autocomplete: "email" } %>
      <%= f.input :password,
                  required: true,
                  hint: ("#{@minimum_password_length} characters minimum" if @minimum_password_length),
                  input_html: { autocomplete: "new-password" } %>
      <%= f.input :password_confirmation,
                  required: true,
                  input_html: { autocomplete: "new-password" } %>
      <%= f.input :birthdate,
                  as: :date,
                  start_year: Date.current.year - 100,
                  end_year: Date.current.year - 4,
                  order: [:day, :month, :year],
                  required: true %>
      <%= f.input :city,
                  required: false,
                  input_html: { autocomplete: "city" } %>

      <button type="submit" class="auth-submit">Sign up</button>
    <% end %>

    <div class="auth-links">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
