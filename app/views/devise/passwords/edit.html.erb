<% content_for(:meta_title, "Reset Password — Kitatoo") %>

<div class="auth">
  <div class="auth-card">
    <div class="auth-logo">
      <%= link_to root_path, class: "topappbar-title" do %>Kitat<span class="topappbar-title__accent">oo</span><% end %>
    </div>
    <h2 class="auth-title">Change your password</h2>
    <p class="auth-hint">Choose a new password for your account</p>

    <%= simple_form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
      <%= f.error_notification %>

      <%= f.input :reset_password_token, as: :hidden %>
      <%= f.full_error :reset_password_token %>

      <%= f.input :password,
                  label: "New password",
                  required: true,
                  autofocus: true,
                  hint: ("#{@minimum_password_length} characters minimum" if @minimum_password_length),
                  input_html: { autocomplete: "new-password" } %>
      <%= f.input :password_confirmation,
                  label: "Confirm your new password",
                  required: true,
                  input_html: { autocomplete: "new-password" } %>

      <button type="submit" class="auth-submit">Change my password</button>
    <% end %>

    <div class="auth-links">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
