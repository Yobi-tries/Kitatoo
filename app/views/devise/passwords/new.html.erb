<% content_for(:meta_title, "Forgot Password — Kitatoo") %>

<div class="auth">
  <div class="auth-card">
    <div class="auth-logo">
      <%= image_tag "kitatoo-logo-ink.png", alt: "Kitatoo" %>
    </div>
    <h2 class="auth-title">Forgot your password?</h2>
    <p class="auth-hint">Enter your email and we'll send you reset instructions</p>

    <%= simple_form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
      <%= f.error_notification %>

      <%= f.input :email,
                  required: true,
                  autofocus: true,
                  input_html: { autocomplete: "email" } %>

      <button type="submit" class="auth-submit">Send reset instructions</button>
    <% end %>

    <div class="auth-links">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
