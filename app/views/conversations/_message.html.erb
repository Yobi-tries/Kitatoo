<% outgoing = message.user == current_user %>
<div class="message-group <%= outgoing ? 'message-group--outgoing' : 'message-group--incoming' %>">
  <div class="message-bubble <%= outgoing ? 'message-bubble--outgoing' : 'message-bubble--incoming' %>">
    <%= message.body %>
  </div>
  <span class="message-timestamp"><%= message.created_at.strftime("%H:%M") %></span>
</div>
