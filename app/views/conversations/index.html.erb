<%= render "shared/topappbar" %>

<div class="container" style="padding-top: 80px; padding-bottom: 90px;">
  <h1 class="mb-4">My conversations</h1>

  <% if @conversations.empty? %>
    <p class="text-muted">You don't have any conversations yet.</p>
  <% else %>
    <div class="list-group">
      <%= render partial: "conversation", collection: @conversations %>
    </div>
  <% end %>
</div>

<%= render "shared/botappbar" %>
