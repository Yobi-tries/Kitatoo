<%= turbo_stream_from @conversation %>

<% booking = Booking.joins(:availability)
     .where(availabilities: { artist_profile_id: @conversation.artist_profile_id },
            client_id: @conversation.client_id)
     .where.not(status: [ :confirmed, :cancelled ]).first %>
<% slot_duration = @conversation.artist_profile.schedule&.dig("slot_duration") || 30 %>
<% is_artist = current_user.artist_profile == @conversation.artist_profile %>
<% confirmed_booking = Booking.joins(:availability)
     .where(availabilities: { artist_profile_id: @conversation.artist_profile_id },
            client_id: @conversation.client_id, status: :confirmed).first %>
<% has_booking = booking.present? || confirmed_booking.present? %>

<div class="container conversation <%= 'has-booking-card' if has_booking %>" style="padding-top: 0;">

  <div class="conversation-header">
    <%= link_to conversations_path, class: "conversation-header-back" do %>
      <i class="fa-solid fa-arrow-left"></i>
    <% end %>
    <% other_name = @conversation.other_participant_name(current_user) %>
    <% avatar = @conversation.artist_profile.avatar_url if current_user.id == @conversation.client_id %>
    <%= image_tag avatar.presence || "https://ui-avatars.com/api/?size=80&background=16130F&color=FBF9F5&name=#{other_name.tr(" ", "+")}",
          class: "conversation-header-avatar", alt: other_name %>
    <% if current_user.artist_profile == @conversation.artist_profile %>
      <span class="conversation-header-name"><%= @conversation.other_participant_name(current_user) %></span>
    <% else %>
      <%= link_to @conversation.other_participant_name(current_user),
            artist_path(@conversation.artist_profile),
            class: "conversation-header-name" %>
    <% end %>
  </div>

  <div class="conversation-messages" id="messages"
       data-controller="chat-scroll chat-messages"
       data-chat-messages-user-id-value="<%= current_user.id %>">
    <%= render partial: "message", collection: @messages %>
  </div>

</div>

<% format_duration = ->(min) { min ? "#{min / 60}h#{format('%02d', min % 60)}" : "" } %>

<div class="conversation-bottom">
  <% if booking&.selected? && is_artist %>
    <div class="booking-card booking-card--pending">
      <div class="booking-card-info">
        <div class="booking-card-info-left">
          <span class="booking-card-label">slot requested</span>
          <span class="booking-card-date"><%= booking.availability.starts_at.strftime("%a %d %b · %H:%M") %></span>
        </div>
        <span class="booking-card-pill">pending</span>
      </div>
      <%= simple_form_for booking, url: confirm_booking_path(booking), method: :patch do |f| %>
        <div class="booking-card-strip">
          <div class="booking-stepper" data-controller="duration" data-duration-step-value="30">
            <button type="button" class="booking-stepper-btn" data-action="duration#decrement">−</button>
            <%= f.input :duration, as: :hidden, input_html: {
              value: slot_duration, data: { duration_target: "input" }
            } %>
            <span class="booking-stepper-display" data-duration-target="display"><%= format_duration.call(slot_duration) %></span>
            <button type="button" class="booking-stepper-btn" data-action="duration#increment">+</button>
          </div>
          <%= f.submit "Confirm", class: "booking-card-confirm" %>
          <%= link_to "✕", cancel_booking_path(booking),
                data: { turbo_method: :patch, turbo_confirm: "Cancel this booking?" },
                class: "booking-card-cancel", title: "Cancel" %>
        </div>
      <% end %>
    </div>

  <% elsif booking&.selected? && !is_artist %>
    <div class="booking-card booking-card--pending">
      <div class="booking-card-info">
        <div class="booking-card-info-left">
          <span class="booking-card-label">slot requested</span>
          <span class="booking-card-date"><%= booking.availability.starts_at.strftime("%a %d %b · %H:%M") %></span>
        </div>
        <span class="booking-card-pill">pending</span>
      </div>
      <div class="booking-card-strip">
        <span class="booking-card-label" style="flex:1;">Waiting for artist</span>
        <%= link_to "✕", cancel_booking_path(booking),
              data: { turbo_method: :patch, turbo_confirm: "Cancel this booking?" },
              class: "booking-card-cancel", title: "Cancel" %>
      </div>
    </div>

  <% elsif booking&.artist_confirmed? && !is_artist %>
    <div class="booking-card booking-card--artist-confirmed">
      <div class="booking-card-info">
        <div class="booking-card-info-left">
          <span class="booking-card-label">slot · duration <%= format_duration.call(booking.duration) %></span>
          <span class="booking-card-date"><%= booking.availability.starts_at.strftime("%a %d %b · %H:%M") %></span>
        </div>
        <span class="booking-card-pill">confirmed</span>
      </div>
      <div class="booking-card-strip">
        <%= button_to "Accept #{format_duration.call(booking.duration)}", accept_booking_path(booking),
            method: :patch, class: "booking-card-accept" %>
        <%= link_to "✕", cancel_booking_path(booking),
              data: { turbo_method: :patch, turbo_confirm: "Cancel this booking?" },
              class: "booking-card-cancel", title: "Cancel" %>
      </div>
    </div>

  <% elsif booking&.artist_confirmed? && is_artist %>
    <div class="booking-card booking-card--artist-confirmed">
      <div class="booking-card-info">
        <div class="booking-card-info-left">
          <span class="booking-card-label">slot · duration <%= format_duration.call(booking.duration) %></span>
          <span class="booking-card-date"><%= booking.availability.starts_at.strftime("%a %d %b · %H:%M") %></span>
        </div>
        <span class="booking-card-pill">confirmed</span>
      </div>
      <div class="booking-card-strip">
        <span class="booking-card-label" style="flex:1;">Waiting for client</span>
        <%= link_to "✕", cancel_booking_path(booking),
              data: { turbo_method: :patch, turbo_confirm: "Cancel this booking?" },
              class: "booking-card-cancel", title: "Cancel" %>
      </div>
    </div>
  <% end %>

  <% if confirmed_booking %>
    <div class="booking-card booking-card--confirmed">
      <div class="booking-card-info">
        <div class="booking-card-info-left">
          <span class="booking-card-label">booked · <%= format_duration.call(confirmed_booking.duration) %></span>
          <span class="booking-card-date"><%= confirmed_booking.availability.starts_at.strftime("%a %d %b · %H:%M") %></span>
        </div>
        <span class="booking-card-pill">set</span>
      </div>
      <div class="booking-card-strip">
        <% if is_artist %>
          <%= link_to complete_booking_path(confirmed_booking),
                data: { turbo_method: :patch, turbo_confirm: "Mark this booking as completed?" },
                class: "booking-card-profile" do %>
            <i class="fa-solid fa-check"></i> Mark as completed
          <% end %>
          <%= link_to "✕", cancel_booking_path(confirmed_booking),
                data: { turbo_method: :patch, turbo_confirm: "Cancel this confirmed booking?" },
                class: "booking-card-cancel", title: "Cancel" %>
        <% else %>
          <%= link_to artist_path(@conversation.artist_profile), class: "booking-card-profile" do %>
            <i class="fa-solid fa-location-dot"></i> Get directions
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>

<%= form_with model: Message.new, url: conversation_messages_path(@conversation), html: { multipart: true }, class: "conversation-composer", data: { controller: "photo-attach" } do |f| %>
  <label class="conversation-composer-attach" for="message_photo">
    <i class="fa-solid fa-plus"></i>
  </label>
  <%= file_field_tag "message[photo]", accept: "image/*", class: "d-none", id: "message_photo",
        data: { photo_attach_target: "input", action: "change->photo-attach#preview" } %>
  <div class="conversation-composer-preview d-none" data-photo-attach-target="preview">
    <img data-photo-attach-target="image" class="conversation-composer-preview-img">
    <button type="button" class="conversation-composer-preview-remove" data-action="photo-attach#remove">&times;</button>
  </div>
  <%= f.text_field :body, class: "conversation-composer-input", placeholder: "Message #{@conversation.other_participant_name(current_user)}...", autocomplete: "off" %>
  <button type="submit" class="conversation-composer-send">
    <i class="fa-solid fa-paper-plane"></i>
  </button>
<% end %>
</div>
