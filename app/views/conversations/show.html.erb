<%= render "shared/topappbar" %>

<% booking = Booking.joins(:availability)
     .where(availabilities: { artist_profile_id: @conversation.artist_profile_id },
            client_id: @conversation.client_id)
     .where.not(status: :confirmed).first %>
<% slot_duration = @conversation.artist_profile.schedule&.dig("slot_duration") || 30 %>
<% is_artist = current_user.artist_profile == @conversation.artist_profile %>
<% confirmed_booking = Booking.joins(:availability)
     .where(availabilities: { artist_profile_id: @conversation.artist_profile_id },
            client_id: @conversation.client_id, status: :confirmed).first %>
<% has_booking = booking.present? || confirmed_booking.present? %>

<div class="container conversation <%= 'has-booking-card' if has_booking %>" style="padding-top: 64px;">

  <div class="conversation-header">
    <%= link_to conversations_path, class: "conversation-header-back" do %>
      <i class="fa-solid fa-arrow-left"></i>
    <% end %>
    <div class="conversation-header-avatar">
      <%= @conversation.other_participant_name(current_user).first(2).upcase %>
    </div>
    <% if current_user.artist_profile == @conversation.artist_profile %>
      <span class="conversation-header-name"><%= @conversation.other_participant_name(current_user) %></span>
    <% else %>
      <%= link_to @conversation.other_participant_name(current_user),
            artist_path(@conversation.artist_profile),
            class: "conversation-header-name" %>
    <% end %>
  </div>

  <div class="conversation-messages" id="messages" data-controller="chat-scroll">
    <%= render partial: "message", collection: @messages %>
  </div>

</div>

<div class="conversation-bottom">
  <% if booking&.selected? && is_artist %>
    <div class="booking-card">
      <div class="booking-card-info">
        <strong>Booking request</strong>
        <span class="booking-card-date"><%= booking.availability.starts_at.strftime("%d/%m %H:%M") %></span>
      </div>
      <%= simple_form_for booking, url: confirm_booking_path(booking), method: :patch, html: { class: "booking-card-form" } do |f| %>
        <div class="booking-duration" data-controller="duration" data-duration-step-value="15">
          <label class="booking-duration-label">Duration</label>
          <div class="booking-duration-counter">
            <button type="button" class="btn" data-action="duration#decrement">−</button>
            <%= f.input :duration, as: :hidden, input_html: {
              value: slot_duration, data: { duration_target: "input" }
            } %>
            <span class="booking-duration-display" data-duration-target="display"><%= slot_duration %> min</span>
            <button type="button" class="btn" data-action="duration#increment">+</button>
          </div>
        </div>
        <%= f.submit "Confirm", class: "btn" %>
      <% end %>
    </div>
  <% elsif booking&.artist_confirmed? && !is_artist %>
    <div class="booking-card booking-card--pending">
      <div class="booking-card-info">
        <strong>Booking proposal</strong>
        <span class="booking-card-date"><%= booking.availability.starts_at.strftime("%d/%m/%Y %H:%M") %> — <%= booking.duration %> min</span>
      </div>
      <%= button_to "Accept", accept_booking_path(booking),
          method: :patch, class: "btn" %>
    </div>
  <% elsif booking&.artist_confirmed? && is_artist %>
    <div class="booking-card booking-card--waiting">
      <div class="booking-card-info">
        <strong>Waiting for client</strong>
        <span class="booking-card-date"><%= booking.availability.starts_at.strftime("%d/%m/%Y %H:%M") %> — <%= booking.duration %> min</span>
      </div>
      <span class="badge bg-warning">Pending</span>
    </div>
  <% end %>
  <% if confirmed_booking %>
    <div class="booking-card booking-card--confirmed">
      <div class="booking-card-info">
        <strong>Booking confirmed</strong>
        <span class="booking-card-date"><%= confirmed_booking.availability.starts_at.strftime("%d/%m/%Y %H:%M") %> — <%= confirmed_booking.duration %> min</span>
      </div>
      <%= link_to artist_path(@conversation.artist_profile), class: "btn" do %>
        Go to profile
      <% end %>
    </div>
  <% end %>

<div class="conversation-composer">
  <button type="button" class="conversation-composer-attach">
    <i class="fa-solid fa-plus"></i>
  </button>
  <%= form_with model: Message.new, url: conversation_messages_path(@conversation), class: "d-flex flex-grow-1 gap-2" do |f| %>
    <%= f.text_field :body, class: "conversation-composer-input", placeholder: "Message #{@conversation.other_participant_name(current_user)}...", autocomplete: "off" %>
    <button type="submit" class="conversation-composer-send">
      <i class="fa-solid fa-paper-plane"></i>
    </button>
  <% end %>
</div>
</div>
