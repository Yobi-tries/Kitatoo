<% other_name = conversation.other_participant_name(current_user) %>
<% avatar = conversation.artist_profile.avatar_url if current_user.id == conversation.client_id %>
<%= link_to conversation_path(conversation), class: "conversation-item" do %>
  <%= image_tag avatar.presence || "https://ui-avatars.com/api/?size=96&background=16130F&color=FBF9F5&name=#{other_name.tr(" ", "+")}",
        class: "conversation-item-avatar", alt: other_name %>
  <div class="conversation-item-body">
    <div class="conversation-item-top">
      <span class="conversation-item-name"><%= conversation.other_participant_name(current_user) %></span>
      <span class="conversation-item-time"><%= format_conversation_time(conversation.updated_at) %></span>
    </div>
    <% if (last_message = conversation.messages.last) %>
      <p class="conversation-item-preview"><%= truncate(last_message.body, length: 60) %></p>
    <% end %>
  </div>
<% end %>
