<%= render "shared/topappbar" %>

<div class="container booking-page">
  <div class="booking-header">
    <%= link_to artist_path(@artist_profile), class: "booking-header-back" do %>
      <i class="fa-solid fa-arrow-left"></i>
    <% end %>
    <span class="booking-header-title">Book a session</span>
    <span class="booking-header-spacer"></span>
  </div>

  <% if @addresses.empty? %>
    <p class="booking-empty">This artist hasn't added a location yet.</p>
  <% elsif @artist_profile.schedule.blank? %>
    <p class="booking-empty">This artist hasn't set their availability yet.</p>
  <% else %>
    <div class="booking-artist-row">
      <%= image_tag @artist_profile.avatar_url.presence || "https://ui-avatars.com/api/?size=112&background=16130F&color=FBF9F5&name=#{@artist_profile.display_name.tr(" ", "+")}",
            class: "booking-artist-avatar", alt: @artist_profile.display_name %>
      <div>
        <h2 class="booking-artist-name"><%= @artist_profile.display_name %></h2>
        <span class="booking-artist-styles"><%= @artist_profile.tags.map(&:name).join(" / ") %></span>
      </div>
    </div>

    <% address = @addresses.first %>
    <div class="booking-location-card">
      <div class="booking-location-top">
        <i class="fa-solid fa-store booking-location-icon"></i>
        <i class="fa-solid fa-check booking-location-check"></i>
      </div>
      <span class="booking-location-name"><%= address.label.presence || "Studio" %></span>
      <span class="booking-location-detail"><%= address.street %>, <%= address.zipcode %> <%= address.city %></span>
    </div>

    <% if @prefill_starts_at.present? %>
      <div class="booking-warning">
        Your original slot was just booked. We've proposed the next available time below.
      </div>
    <% end %>

    <%= simple_form_for @booking, url: artist_profile_bookings_path(@artist_profile),
          html: { data: { controller: "booking-form" } } do |f| %>
      <%= f.error_notification %>
      <%= hidden_field_tag "booking[address_id]", address.id %>

      <div class="booking-section" data-action="calendar:slotSelected->booking-form#onSlotSelected">
        <label class="booking-label">Date & time</label>
        <%= render "shared/calendar", artist_profile: @artist_profile, month: @month,
              prefill_starts_at: @prefill_starts_at, prefill_ends_at: @prefill_ends_at %>
      </div>

      <div class="booking-section">
        <%= f.input :description, as: :text, required: true, label: false,
              placeholder: "Describe your tattoo idea: style, size, placement...",
              input_html: {
                class: "booking-description",
                data: { booking_form_target: "description", action: "input->booking-form#update" }
              } %>
      </div>

      <div class="booking-summary" data-booking-form-target="summary">
        <span class="booking-summary-label">Selected session</span>
        <span class="booking-summary-value" data-booking-form-target="summaryDate">Pick a slot above</span>
        <span class="booking-summary-detail" data-booking-form-target="summaryLocation"><%= address.label.presence || address.city %></span>
      </div>

      <button type="submit" class="booking-submit" data-booking-form-target="submit" disabled>
        Request booking <i class="fa-solid fa-arrow-right"></i>
      </button>
    <% end %>
  <% end %>
</div>

<%= render "shared/botappbar" %>
