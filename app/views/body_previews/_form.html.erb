<div id="body_preview_form">
  <% if local_assigns[:error] %>
    <div class="alert alert-danger"><%= error %></div>
  <% end %>

  <%= form_with url: body_previews_path, method: :post, multipart: true do %>
    <input type="hidden" name="tattoo_generation_id" value="<%= local_assigns[:tattoo_generation_id] %>"
           data-body-preview-source-target="generationIdInput">

    <div class="row g-3">
      <div class="col-md-6">
        <label class="tattoo-drawer__label d-block">Tattoo design</label>
        <%= image_tag local_assigns[:source_image_url].presence || "data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBTAA7",
              class: "tattoo-drawer__image mb-2 #{"d-none" if local_assigns[:source_image_url].blank?}",
              data: { "body-preview-source-target": "preview" }, alt: "Selected tattoo design" %>
        <label class="body-upload-dropzone <%= "d-none" if local_assigns[:source_image_url].present? %>"
               data-body-preview-source-target="uploadField">
          <i class="fa-solid fa-cloud-arrow-up"></i>
          <span class="body-upload-dropzone-title">Upload tattoo design</span>
          <span class="body-upload-dropzone-hint">PNG, JPG</span>
          <input type="file" name="design_image" accept="image/*" class="visually-hidden"
                 data-action="change->body-preview-source#designImageSelected">
        </label>
      </div>

      <div class="col-md-6">
        <label class="tattoo-drawer__label d-block">Your body photo</label>
        <%= image_tag "data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBTAA7",
              class: "tattoo-drawer__image mb-2 d-none",
              data: { "body-preview-source-target": "bodyPreview" }, alt: "Your body photo" %>
        <div class="body-photo-picker" data-body-preview-source-target="bodyUploadField">
          <div class="body-photo-picker-actions">
            <label class="body-photo-picker-action body-photo-picker-action--camera">
              <i class="fa-solid fa-camera" aria-hidden="true"></i>
              <span class="body-photo-picker-action-title">Take body photo</span>
              <span class="body-photo-picker-action-hint">With phone</span>
              <input type="file" name="body_photo_camera" accept="image/*" capture="environment" class="visually-hidden"
                     data-action="change->body-preview-source#bodyPhotoSelected">
            </label>

            <label class="body-photo-picker-action body-photo-picker-action--upload">
              <i class="fa-solid fa-cloud-arrow-up" aria-hidden="true"></i>
              <span class="body-photo-picker-action-title">Upload body photo</span>
              <span class="body-photo-picker-action-hint">PNG, JPG</span>
              <input type="file" name="body_photo_upload" accept="image/*" class="visually-hidden"
                     data-action="change->body-preview-source#bodyPhotoSelected">
            </label>
          </div>
          <p class="body-photo-picker-hint">Use a clear, well-lit photo of the area you want tattooed.</p>
        </div>
      </div>
    </div>

    <%= submit_tag "Preview on body", class: "btn btn-primary w-100 tattoo-drawer__submit mt-2",
          data: { turbo_submits_with: "Generating..." } %>
    <p class="text-center text-muted small mt-2 mb-0">Takes ~45–60 seconds</p>
  <% end %>
</div>
