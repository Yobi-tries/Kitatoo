<div id="body_preview_form">
  <% if local_assigns[:error] %>
    <div class="alert alert-danger"><%= error %></div>
  <% end %>

  <%= form_with url: body_previews_path, method: :post, multipart: true do %>
    <input type="hidden" name="tattoo_generation_id" value="<%= local_assigns[:tattoo_generation_id] %>"
           data-body-preview-source-target="generationIdInput">

    <div class="row g-3">
      <div class="col-md-6">
        <label class="tattoo-drawer__label d-block">Tattoo design</label>
        <div class="tattoo-source-preview mb-2 <%= "d-none" if local_assigns[:source_image_url].blank? %>"
             data-body-preview-source-target="previewWrap">
          <%= image_tag local_assigns[:source_image_url].presence || "data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBTAA7",
                class: "tattoo-drawer__image",
                data: { "body-preview-source-target": "preview" }, alt: "Selected tattoo design" %>
          <button type="button" class="reference-thumb-remove" aria-label="Remove tattoo design"
                  data-action="body-preview-source#removeDesign">
            <i class="fa-solid fa-xmark"></i>
          </button>
        </div>
        <label class="body-upload-dropzone <%= "d-none" if local_assigns[:source_image_url].present? %>"
               data-body-preview-source-target="uploadField">
          <i class="fa-solid fa-cloud-arrow-up"></i>
          <span class="body-upload-dropzone-title">Upload image</span>
          <span class="body-upload-dropzone-hint">PNG, JPG</span>
          <input type="file" name="design_image" accept="image/*" class="visually-hidden"
                 data-body-preview-source-target="designPhotoInput"
                 data-action="change->body-preview-source#designImageSelected">
        </label>
      </div>

      <div class="col-md-6">
        <label class="tattoo-drawer__label d-block">Your body photo</label>
        <div class="tattoo-source-preview mb-2 d-none" data-body-preview-source-target="bodyPreviewWrap">
          <%= image_tag "data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBTAA7",
                class: "tattoo-drawer__image",
                data: { "body-preview-source-target": "bodyPreview" }, alt: "Your body photo" %>
          <button type="button" class="reference-thumb-remove" aria-label="Remove body photo"
                  data-action="body-preview-source#removeBodyPhoto">
            <i class="fa-solid fa-xmark"></i>
          </button>
        </div>
        <label class="body-upload-dropzone" data-body-preview-source-target="bodyUploadField">
          <i class="fa-solid fa-camera"></i>
          <span class="body-upload-dropzone-title">Upload body photo</span>
          <span class="body-upload-dropzone-hint">Frame the area you want tattooed</span>
          <input type="file" name="body_photo" accept="image/*" class="visually-hidden"
                 data-body-preview-source-target="bodyPhotoInput"
                 data-action="change->body-preview-source#bodyPhotoSelected">
        </label>
      </div>
    </div>

    <%= submit_tag "Preview on body", class: "btn btn-primary w-100 tattoo-drawer__submit mt-2",
          data: { turbo_submits_with: "Generating..." } %>
    <p class="tattoo-generator-hint">~ 45 – 60sec</p>
  <% end %>
</div>
