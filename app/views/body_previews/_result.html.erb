<div id="body_preview_result" class="tattoo-drawer__result">
  <% if body_preview.nil? %>
  <% elsif body_preview.completed? %>
    <h2 class="tattoo-drawer__title">Body preview</h2>
    <%= image_tag body_preview.preview_image_url, class: "tattoo-drawer__image", alt: "Tattoo body preview" %>
    <% download_url = Cloudinary::Utils.cloudinary_url(
         body_preview.preview_image_public_id,
         resource_type: "image", type: "upload", flags: "attachment", secure: true
       ) %>
    <%= link_to "Download image", download_url,
          download: "body-preview-#{body_preview.id}.png",
          class: "btn btn-outline-dark w-100 tattoo-drawer__action" %>
    <%= link_to "Try another placement", new_tattoo_generation_path,
          class: "btn w-100 tattoo-drawer__action tattoo-drawer__action--secondary" %>
  <% elsif body_preview.failed? %>
    <div class="alert tattoo-drawer__error mb-0">
      Body preview failed. Please try again.
    </div>
    <%= link_to "Try again", new_tattoo_generation_path, class: "btn btn-outline-dark w-100 tattoo-drawer__action" %>
  <% else %>
    <div class="tattoo-drawer__pending">
      <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
      Creating body preview...
    </div>
  <% end %>
</div>
