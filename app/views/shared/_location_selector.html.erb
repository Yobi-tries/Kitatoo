<div class="location-selector">
  <% addresses.each do |address| %>
    <% selected = selected_address.present? && address.id == selected_address.id %>
    <%= link_to path_for.call(address), class: "location-card #{'location-card--selected' if selected}" do %>
      <div class="location-card-top">
        <i class="fa-solid fa-store location-card-icon"></i>
        <% if selected %><i class="fa-solid fa-check location-card-check"></i><% end %>
      </div>
      <span class="location-card-label"><%= address.label.presence || "Studio" %></span>
      <span class="location-card-detail">
        <span><%= address.street %></span>
        <span><%= address.zipcode %> <%= address.city %></span>
      </span>
    <% end %>
  <% end %>
</div>
