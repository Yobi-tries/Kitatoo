<% if notice %>
  <div class="flash flash--notice" role="alert" data-controller="flash">
    <span><%= notice %></span>
    <button type="button" class="flash-close" data-action="flash#dismiss">&times;</button>
  </div>
<% end %>
<% if alert %>
  <div class="flash flash--alert" role="alert" data-controller="flash">
    <span><%= alert %></span>
    <button type="button" class="flash-close" data-action="flash#dismiss">&times;</button>
  </div>
<% end %>
