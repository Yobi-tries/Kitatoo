<header class="topappbar d-flex justify-content-between align-items-center">
  <button class="topappbar-btn" data-bs-toggle="offcanvas" data-bs-target="#sideMenu">
    <span class="material-symbols-outlined">menu</span>
  </button>

  <%= link_to root_path do %>
    <%= image_tag "kitatoo-logo-ink.png", alt: "Kitatoo", class: "topappbar-logo" %>
  <% end %>

  <% if local_assigns[:hide_right] %>
    <span class="topappbar-btn"></span>
  <% elsif user_signed_in? %>
    <button type="button" class="topappbar-btn" data-bs-toggle="offcanvas" data-bs-target="#tattooGeneratorDrawer" aria-label="Generate a tattoo with AI">
      <i class="fa-solid fa-robot"></i>
    </button>
  <% else %>
    <%= link_to new_tattoo_generation_path, class: "topappbar-btn", "aria-label": "Generate a tattoo with AI" do %>
      <i class="fa-solid fa-robot"></i>
    <% end %>
  <% end %>
</header>

<div class="offcanvas offcanvas-start d-flex flex-column" id="sideMenu">
  <div class="offcanvas-header">
    <%= image_tag "kitatoo-logo-ink.png", alt: "Kitatoo", height: 32 %>
    <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
  </div>
  <div class="offcanvas-body flex-grow-1">
    <ul class="nav flex-column">
      <% if user_signed_in? %>
        <li class="nav-item">
          <%= link_to destroy_user_session_path, data: { turbo_method: :delete }, class: "nav-link text-danger" do %>
            Sign out
          <% end %>
        </li>
      <% end %>
    </ul>
  </div>
</div>

<%= render "shared/portfolio_upload_modal" if user_signed_in? && current_user.artist_profile.present? %>

<%= render "tattoo_generations/drawer" if user_signed_in? %>
