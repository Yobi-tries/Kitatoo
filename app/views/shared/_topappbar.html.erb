<header class="topappbar d-flex justify-content-between align-items-center" data-controller="search-modal topappbar">
  <%= link_to root_path, class: "topappbar-title" do %><span class="topappbar-title__accent">Ki</span>tatoo<% end %>

  <div class="topappbar-right">
    <button type="button" class="topappbar-search-btn" data-action="search-modal#open" aria-label="Search">
      <span class="material-symbols-outlined">search</span>
    </button>
  </div>
</header>

<div class="search-modal-overlay d-none" id="searchModalOverlay">
  <%= form_with url: root_path, method: :get, class: "search-modal-bar", id: "searchModalBar" do %>
    <span class="material-symbols-outlined search-modal-icon">search</span>
    <%= text_field_tag :query, params[:query],
          placeholder: "Search artists, styles, studios...",
          class: "search-modal-input" %>
  <% end %>
</div>

<div class="offcanvas offcanvas-start d-flex flex-column" id="sideMenu">
  <div class="offcanvas-header">
    <%= image_tag "kitatoo-logo-ink.png", alt: "Kitatoo", height: 32 %>
    <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
  </div>
  <div class="offcanvas-body flex-grow-1">
    <ul class="nav flex-column">
      <% if user_signed_in? %>
        <li class="nav-item">
          <%= link_to destroy_user_session_path, data: { turbo_method: :delete }, class: "nav-link text-danger" do %>
            Sign out
          <% end %>
        </li>
      <% end %>
    </ul>
  </div>
</div>

<%= render "shared/portfolio_upload_modal" if user_signed_in? && current_user.artist_profile.present? %>

<% if user_signed_in? %>
  <% tattoo_generation = current_user.last_tattoo_generation %>
  <%= render "tattoo_generations/drawer", tattoo_generation: tattoo_generation %>
<% end %>
