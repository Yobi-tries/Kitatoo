<% tattoo_generation = current_user.last_tattoo_generation if user_signed_in? %>

<header class="topappbar d-flex justify-content-between align-items-center">
  <div class="topappbar-left">
    <% if user_signed_in? %>
      <button class="topappbar-btn topappbar-arrow" data-bs-toggle="offcanvas" data-bs-target="#sideMenu">
        <span class="material-symbols-outlined">arrow_forward_ios</span>
      </button>
    <% end %>
    <%= link_to "Kitatoo", root_path, class: "topappbar-title" %>
  </div>

  <% if !user_signed_in? %>
    <%= link_to new_user_session_path, class: "topappbar-btn", "aria-label": "Sign in or sign up" do %>
      <i class="fa-solid fa-right-to-bracket"></i>
    <% end %>
  <% elsif local_assigns[:hide_right] %>
    <span class="topappbar-btn"></span>
  <% else %>
    <button type="button" class="topappbar-btn" data-bs-toggle="offcanvas" data-bs-target="#tattooGeneratorDrawer" aria-label="Generate a tattoo with AI">
      <%= render "tattoo_generations/robot_badge", tattoo_generation: tattoo_generation %>
    </button>
  <% end %>
</header>

<div class="offcanvas offcanvas-start d-flex flex-column" id="sideMenu">
  <div class="offcanvas-header">
    <%= image_tag "kitatoo-logo-ink.png", alt: "Kitatoo", height: 32 %>
    <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
  </div>
  <div class="offcanvas-body flex-grow-1">
    <ul class="nav flex-column">
      <% if user_signed_in? %>
        <li class="nav-item">
          <%= link_to destroy_user_session_path, data: { turbo_method: :delete }, class: "nav-link text-danger" do %>
            Sign out
          <% end %>
        </li>
      <% end %>
    </ul>
  </div>
</div>

<%= render "shared/portfolio_upload_modal" if user_signed_in? && current_user.artist_profile.present? %>

<%= render "tattoo_generations/drawer", tattoo_generation: tattoo_generation if user_signed_in? %>
