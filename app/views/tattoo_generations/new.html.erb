<% content_for(:title, "AI Tattoo Generator — Kitatoo") %>

<%= render "shared/topappbar" %>

<% if user_signed_in? %>
  <%= turbo_stream_from [ current_user, :tattoo_generations ] %>
  <%= turbo_stream_from [ current_user, :body_previews ] %>
<% end %>

<div class="container tattoo-generator-page" data-controller="body-preview-source">
  <div class="tattoo-generator-hero">
    <div class="tattoo-generator-hero-copy">

      <h1 class="tattoo-generator-title">
        <span class="tattoo-generator-title-main">Design your</span>
        <span class="tattoo-generator-title-accent">own tattoo</span>
      </h1>

      <p class="tattoo-generator-subtitle">
        Professional and stunning results.<br>
        Preview on your body before you ink.
      </p>

      <div class="tattoo-generator-benefits">
        <div class="tattoo-generator-benefit">
          <span class="tattoo-generator-benefit-icon">
            <i class="fa-solid fa-user-gear"></i>
          </span>
          <div>
            <strong>Personalize it</strong>
            <span>Your idea, your style, your story</span>
          </div>
        </div>

        <div class="tattoo-generator-benefit">
          <span class="tattoo-generator-benefit-icon">
            <i class="fa-solid fa-droplet"></i>
          </span>
          <div>
            <strong>Make it</strong>
            <span>Turn your idea into a tattoo-ready design</span>
          </div>
        </div>

        <div class="tattoo-generator-benefit">
          <span class="tattoo-generator-benefit-icon">
            <i class="fa-solid fa-eye"></i>
          </span>
          <div>
            <strong>Try it</strong>
            <span>Realistic preview on your body</span>
          </div>
        </div>
      </div>
    </div>

    <div class="tattoo-generator-hero-demo">
      <div class="tattoo-generator-demo-card tattoo-generator-demo-card--reference">
        <span class="tattoo-generator-demo-step">1</span>

        <%= image_tag "https://res.cloudinary.com/efbi2pls/image/upload/v1788266618/Real.png",
              alt: "Reference image",
              class: "tattoo-generator-demo-image" %>
      </div>

      <div class="tattoo-generator-demo-card tattoo-generator-demo-card--design">
        <span class="tattoo-generator-demo-step">2</span>

        <%= image_tag "https://res.cloudinary.com/efbi2pls/image/upload/v1788259722/Your_design.jpg",
              alt: "Generated tattoo design",
              class: "tattoo-generator-demo-image" %>
      </div>

      <div class="tattoo-generator-demo-card tattoo-generator-demo-card--body">
        <span class="tattoo-generator-demo-step">3</span>

        <%= image_tag "https://res.cloudinary.com/efbi2pls/image/upload/v1788259722/Preview.jpg",
              alt: "Tattoo previewed on a forearm",
              class: "tattoo-generator-demo-image" %>
      </div>
    </div>
  </div>

  <p class="tattoo-generator-divider"><span>Get started</span></p>

  <div class="tattoo-generator-grid">
    <div class="tattoo-generator-card" data-controller="collapsible-card">
      <h2 class="tattoo-generator-card-heading">
        <button class="tattoo-generator-card-header"
                type="button"
                data-action="collapsible-card#toggle"
                data-collapsible-card-target="button"
                aria-expanded="false"
                aria-controls="create-tattoo-card-content"
                aria-labelledby="create-tattoo-card-title"
                aria-describedby="create-tattoo-card-subtitle">
          <span class="tattoo-generator-card-icon" aria-hidden="true"><i class="fa-solid fa-paintbrush"></i></span>
          <span class="tattoo-generator-card-copy">
            <span id="create-tattoo-card-title" class="tattoo-generator-card-title">Create</span>
            <span id="create-tattoo-card-subtitle" class="tattoo-generator-card-subtitle">Transform your idea into reality.</span>
          </span>
          <span class="tattoo-generator-card-arrow" aria-hidden="true"><i class="fa-solid fa-chevron-down"></i></span>
        </button>
      </h2>

      <div id="create-tattoo-card-content"
           class="tattoo-generator-card-content"
           data-collapsible-card-target="content"
           role="region"
           aria-labelledby="create-tattoo-card-title"
           hidden>
        <%= render "tattoo_generations/create_form" %>
        <%= render "tattoo_generations/result", tattoo_generation: @tattoo_generation %>
      </div>
    </div>

    <div class="tattoo-generator-card"
         data-controller="collapsible-card"
         data-body-preview-source-target="bodyPreviewCard"
         data-action="body-preview-source:open-card->collapsible-card#open">
      <h2 class="tattoo-generator-card-heading">
        <button class="tattoo-generator-card-header"
                type="button"
                data-action="collapsible-card#toggle"
                data-collapsible-card-target="button"
                aria-expanded="false"
                aria-controls="body-preview-card-content"
                aria-labelledby="body-preview-card-title"
                aria-describedby="body-preview-card-subtitle">
          <span class="tattoo-generator-card-icon" aria-hidden="true"><i class="fa-solid fa-user-pen"></i></span>
          <span class="tattoo-generator-card-copy">
            <span id="body-preview-card-title" class="tattoo-generator-card-title">Preview</span>
            <span id="body-preview-card-subtitle" class="tattoo-generator-card-subtitle">See your design on your body.</span>
          </span>
          <span class="tattoo-generator-card-arrow" aria-hidden="true"><i class="fa-solid fa-chevron-down"></i></span>
        </button>
      </h2>

      <div id="body-preview-card-content"
           class="tattoo-generator-card-content"
           data-collapsible-card-target="content"
           role="region"
           aria-labelledby="body-preview-card-title"
           hidden>
        <%= render "body_previews/form" %>
        <%= render "body_previews/result", body_preview: @body_preview %>
      </div>
    </div>
  </div>
</div>

<%= render "shared/botappbar" %>
