<div class="mb-3" data-controller="reference-images" data-reference-images-max-value="3">
  <label class="tattoo-drawer__label d-block">Reference images <span class="text-muted small">(optional, up to 3)</span></label>
  <input type="file" name="reference_images[]" accept="image/*" multiple class="form-control mb-2"
         data-reference-images-target="fileInput" data-action="change->reference-images#filesSelected">
  <div class="d-flex flex-wrap gap-2" data-reference-images-target="previews"></div>
</div>
