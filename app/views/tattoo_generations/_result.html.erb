<div id="tattoo_generation_result" class="tattoo-drawer__result"
     data-result-seen-target="result"
     data-completed="<%= tattoo_generation&.completed? ? "true" : "false" %>"
     data-mark-viewed-url="<%= mark_viewed_tattoo_generation_path(tattoo_generation) if tattoo_generation&.completed? %>">
  <% if tattoo_generation.nil? %>
  <% elsif tattoo_generation.completed? %>
    <h2 class="tattoo-drawer__title">Generated design</h2>
    <%= image_tag tattoo_generation.image_url, class: "tattoo-drawer__image", alt: "Generated tattoo design" %>
    <% download_url = Cloudinary::Utils.cloudinary_url(
         tattoo_generation.image_public_id,
         resource_type: "image", type: "upload", flags: "attachment", secure: true
       ) %>
    <%= button_tag "See on body", type: "button", class: "btn btn-primary w-100 tattoo-drawer__action",
          data: { action: "body-preview-source#useGenerated",
                  "body-preview-source-image-url-param": tattoo_generation.image_url,
                  "body-preview-source-generation-id-param": tattoo_generation.id } %>
    <%= link_to "Download image", download_url,
          download: "tattoo-#{tattoo_generation.id}.png",
          class: "btn btn-outline-dark w-100 tattoo-drawer__action" %>
    <%= link_to "Generate again", new_tattoo_generation_path,
          class: "btn w-100 tattoo-drawer__action tattoo-drawer__action--secondary" %>
  <% elsif tattoo_generation.failed? %>
    <div class="alert tattoo-drawer__error mb-0">
      Image generation failed. Please try again.
    </div>
    <%= link_to "Try again", new_tattoo_generation_path, class: "btn btn-outline-dark w-100 tattoo-drawer__action" %>
  <% else %>
    <div class="tattoo-drawer__pending">
      <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
      Generating...
    </div>
  <% end %>
</div>
