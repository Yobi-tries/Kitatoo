<div id="tattoo_generation_result" class="tattoo-drawer__result">
  <% if tattoo_generation.completed? %>
    <h2 class="tattoo-drawer__title">Generated design</h2>
    <%= image_tag tattoo_generation.image_url, class: "tattoo-drawer__image", alt: "Generated tattoo design" %>
    <% download_url = Cloudinary::Utils.cloudinary_url(
         tattoo_generation.image_public_id,
         resource_type: "image", type: "upload", flags: "attachment", secure: true
       ) %>
    <%= link_to "Download image", download_url,
          download: "tattoo-#{tattoo_generation.id}.png",
          class: "btn btn-outline-dark w-100 tattoo-drawer__action" %>
    <% if local_assigns[:in_drawer] %>
      <button type="button" class="btn w-100 tattoo-drawer__action tattoo-drawer__action--secondary" data-action="tattoo-drawer#reset">
        Generate again
      </button>
    <% end %>
  <% elsif tattoo_generation.failed? %>
    <div class="alert tattoo-drawer__error mb-0">
      Image generation failed. Please try again.
    </div>
    <% if local_assigns[:in_drawer] %>
      <button type="button" class="btn btn-outline-dark w-100 tattoo-drawer__action" data-action="tattoo-drawer#reset">
        Try again
      </button>
    <% end %>
  <% else %>
    <div class="tattoo-drawer__pending">
      <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
      Generating...
    </div>
  <% end %>
</div>
