<div id="tattoo_generation_result">
  <% if tattoo_generation.completed? %>
    <h2 class="h5 mb-2">Generated design</h2>
    <%= image_tag tattoo_generation.image_url, class: "img-fluid rounded mb-2", alt: "Generated tattoo design" %>
    <% download_url = Cloudinary::Utils.cloudinary_url(
         tattoo_generation.image_public_id,
         resource_type: "image", type: "upload", flags: "attachment", secure: true
       ) %>
    <%= link_to "Download image", download_url,
          download: "tattoo-#{tattoo_generation.id}.png",
          class: "btn btn-outline-dark w-100" %>
    <% if local_assigns[:in_drawer] %>
      <button type="button" class="btn btn-link w-100 mt-2" data-action="tattoo-drawer#reset">
        Generate again
      </button>
    <% end %>
  <% elsif tattoo_generation.failed? %>
    <div class="alert alert-danger mb-0">
      Image generation failed. Please try again.
    </div>
    <% if local_assigns[:in_drawer] %>
      <button type="button" class="btn btn-outline-dark w-100 mt-2" data-action="tattoo-drawer#reset">
        Try again
      </button>
    <% end %>
  <% else %>
    <div class="d-flex align-items-center gap-2 text-muted">
      <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
      Generating...
    </div>
  <% end %>
</div>
