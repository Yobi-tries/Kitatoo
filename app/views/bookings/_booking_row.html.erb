<%
  starts_at = booking.availability.starts_at
  status_label = if booking.confirmed?
                   "confirmed"
                 elsif booking.completed?
                   "completed"
                 elsif booking.cancelled?
                   "cancelled"
                 else
                   "pending"
                 end
  target_path = conversation ? conversation_path(conversation) : nil
%>
<div id="<%= dom_id(booking) %>" class="booking-row">
  <div class="booking-row-avatar"><%= booking.client.username.first(2).upcase %></div>

  <div class="booking-row-body">
    <h3 class="booking-row-name">
      <% if target_path %>
        <%= link_to booking.client.username, target_path, class: "stretched-link" %>
      <% else %>
        <%= booking.client.username %>
      <% end %>
    </h3>
    <span class="booking-row-meta">
      <%= starts_at.strftime("%a %d %b · %H:%M") %>
      <% if booking.duration %> &middot; <%= "#{booking.duration / 60}h#{format('%02d', booking.duration % 60)}" %><% end %>
    </span>
    <span class="booking-row-status booking-row-status--<%= status_label %>"><%= status_label %></span>
  </div>

  <% if show_cancel %>
    <%= link_to "✕", cancel_booking_path(booking),
          data: { turbo_method: :patch, turbo_confirm: "Cancel this booking?" },
          class: "booking-row-cancel", title: "Cancel" %>
  <% else %>
    <i class="fa-solid fa-chevron-right booking-row-chevron"></i>
  <% end %>
</div>
