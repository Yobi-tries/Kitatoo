<% content_for(:meta_title, "My Bookings — Kitatoo") %>

<%= turbo_stream_from [ current_user, :bookings ] %>
<% if @artist_profile %>
  <%= turbo_stream_from [ @artist_profile, :bookings ] %>
<% end %>

<%= render "shared/topappbar", hide_right: true %>

<div class="container bookings-index">

  <% if @artist_profile %>
    <%= render "bookings/role_toggle", view: @view %>
  <% end %>

  <% if @view == "client" %>
  <% if @client_upcoming.empty? && @client_past.empty? && @client_cancelled.empty? %>
    <p class="bookings-empty">
      No bookings yet. <%= link_to "Browse artists", artists_path %> to get started.
    </p>
  <% else %>
    <% if @client_upcoming.any? %>
      <div class="home-section-header">
        <h3 class="home-section-title">Upcoming</h3>
        <span class="home-section-meta"><%= @client_upcoming.size %></span>
      </div>
      <div class="bookings-list">
        <% @client_upcoming.each do |booking| %>
          <%= render "bookings/booking_card", booking: booking, viewer_role: :client,
                conversation: @client_conversations_by_artist[booking.availability.artist_profile_id],
                show_cancel: !booking.confirmed? %>
        <% end %>
      </div>
    <% end %>

    <% if @client_past.any? %>
      <div class="home-section-header">
        <h3 class="home-section-title">Past</h3>
        <span class="home-section-meta"><%= @client_past.size %></span>
      </div>
      <div class="bookings-list">
        <% @client_past.each do |booking| %>
          <%= render "bookings/booking_card", booking: booking, viewer_role: :client,
                conversation: @client_conversations_by_artist[booking.availability.artist_profile_id],
                show_cancel: false %>
        <% end %>
      </div>
    <% end %>

    <% if @client_cancelled.any? %>
      <div class="home-section-header">
        <h3 class="home-section-title">Cancelled</h3>
        <span class="home-section-meta"><%= @client_cancelled.size %></span>
      </div>
      <div class="bookings-list">
        <% @client_cancelled.each do |booking| %>
          <%= render "bookings/booking_card", booking: booking, viewer_role: :client,
                conversation: @client_conversations_by_artist[booking.availability.artist_profile_id],
                show_cancel: false %>
        <% end %>
      </div>
    <% end %>
  <% end %>
  <% end %>

  <% if @view == "artist" %>
    <div class="home-section-header">
      <h2 class="home-section-title">Requests received</h2>
    </div>

    <%= render "bookings/location_filter", addresses: @addresses, selected_address: @selected_address, status: @status %>

    <% if @artist_pending.empty? && @artist_upcoming.empty? && @artist_to_complete.empty? && @artist_history.empty? && @artist_cancelled.empty? %>
      <p class="bookings-empty">No booking requests yet.</p>
    <% else %>
      <%= render "bookings/status_dropdown", status: @status, address: @selected_address %>

      <% case @status
         when "requests" %>
        <% if @artist_pending.empty? %>
          <p class="bookings-empty">No pending requests.</p>
        <% else %>
          <div class="bookings-list">
            <% @artist_pending.each do |booking| %>
              <%= render "bookings/booking_card", booking: booking, viewer_role: :artist,
                    conversation: @artist_conversations_by_client[booking.client_id],
                    show_cancel: true %>
            <% end %>
          </div>
        <% end %>
      <% when "upcoming" %>
        <% if @needs_action_dates.any? %>
          <div class="agenda-needs-action">
            <% @needs_action_dates.each do |d| %>
              <%= link_to d.strftime("%b %-d"),
                    bookings_path(status: "upcoming", address_id: @selected_address&.id, date: d),
                    id: "needs_action_#{d.iso8601}", class: "agenda-needs-action-chip" %>
            <% end %>
          </div>
        <% end %>

        <%= turbo_frame_tag "agenda" do %>
          <%= render "bookings/agenda", date: @agenda_date, bookings: @agenda_bookings %>
        <% end %>
      <% when "history" %>
        <% if @artist_history.empty? %>
          <p class="bookings-empty">No completed sessions yet.</p>
        <% else %>
          <%= link_to bookings_path(format: :csv, address_id: @selected_address&.id, status: "history"),
                class: "bookings-csv-link" do %>
            <i class="fa-solid fa-download"></i> Download CSV
          <% end %>
          <div class="bookings-list">
            <% @artist_history.each do |booking| %>
              <%= render "bookings/booking_row", booking: booking,
                    conversation: @artist_conversations_by_client[booking.client_id],
                    show_cancel: false %>
            <% end %>
          </div>
        <% end %>
      <% when "cancelled" %>
        <% if @artist_cancelled.empty? %>
          <p class="bookings-empty">No cancelled bookings.</p>
        <% else %>
          <div class="bookings-list">
            <% @artist_cancelled.each do |booking| %>
              <%= render "bookings/booking_row", booking: booking,
                    conversation: @artist_conversations_by_client[booking.client_id],
                    show_cancel: false %>
            <% end %>
          </div>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

</div>

<%= render "shared/botappbar" %>
