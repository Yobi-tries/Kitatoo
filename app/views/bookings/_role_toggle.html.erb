<div class="role-toggle">
  <%= link_to "As artist", bookings_path(view: "artist"),
        class: "role-toggle-btn #{'role-toggle-btn--active' if view == "artist"}" %>
  <%= link_to "As client", bookings_path(view: "client"),
        class: "role-toggle-btn #{'role-toggle-btn--active' if view == "client"}" %>
</div>
